# ============================================================
# AI PC Builder — variables d'environnement (NE JAMAIS committer .env)
# Copier vers .env puis renseigner. Voir DEPLOYMENT.md
# ============================================================

# --- Database (PostgreSQL prod / SQLite fallback documenté) ---
# Prod recommandé : postgresql://user:password@localhost:5432/aipcbuilder
DATABASE_URL="postgresql://aipcbuilder:aipcbuilder@localhost:5432/aipcbuilder?schema=public"
# Dev sans Postgres : l'app fonctionne en mode DEMO in-memory (dataset src/lib/demo-data.ts)
# et n'exige PAS de DB. Ne mettre DATABASE_URL que si Postgres est disponible.

# --- Auth (NextAuth v5 / Auth.js) ---
AUTH_SECRET="generer-avec-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# OAuth (optionnel, laisser vide si non configuré — l'UI le détecte et masque les boutons)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- IA : orchestration multi-providers ---
# AI_PROVIDER=heuristic (défaut, 100% offline, déterministe) | openai | anthropic | mistral | ollama
AI_PROVIDER="heuristic"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL=""
# Exemples :
# AI_PROVIDER=openai  + AI_API_KEY=sk-... (+ optionnel AI_MODEL, AI_BASE_URL)
# AI_PROVIDER=ollama  + AI_BASE_URL=http://localhost:11434 + AI_MODEL=llama3.1
OLLAMA_BASE_URL="http://localhost:11434"

# --- Email (notifications / alertes prix / vérification) ---
# EMAIL_PROVIDER=resend | smtp | none
EMAIL_PROVIDER="none"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="alerts@example.com"

# --- Affiliation (AUCUN lien inventé : seuls les marchands configurés ici génèrent des liens) ---
# Format : id|network|base_url|tracking_param|active|priority
# Exemple : amazon|amazon|https://www.amazon.fr/dp/|tag=monsite-21|true|10
AFFILIATE_MERCHANTS=""
AFFILIATE_DISCLOSURE_TEXT="Certains liens peuvent générer une commission sans surcoût pour vous."
AFFILIATE_DEFAULT_TAG_AMAZON=""

# --- Analytics respectueux (aucun tracker tiers par défaut) ---
ANALYTICS_ENABLED="true"

# --- Scraping / ingestion : respecter robots.txt + CGU. Sources officielles uniquement. ---
DATA_INGEST_ENABLED="false"
DATA_INGEST_CRON="0 3 * * *"

# --- Redis (optionnel, cache prix/sessions) ---
REDIS_URL=""

# --- Admin bootstrap (créé par prisma/seed.ts) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
